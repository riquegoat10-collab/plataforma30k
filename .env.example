# Chave da API do Claude (gera e edita os sites). Sem ela, o app usa textos-modelo.
ANTHROPIC_API_KEY=

# Chave da Google Places API (New) para o radar. Sem ela, o radar mostra dados de demonstração.
GOOGLE_PLACES_API_KEY=

# Endereço público do app, usado nos links enviados aos clientes.
NEXT_PUBLIC_APP_URL=http://localhost:3000
